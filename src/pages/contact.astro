---
import BaseLayout from "../layouts/BaseLayout.astro";
import { pages, profiles } from "../data/profile";
---

<BaseLayout pageTitle={pages.contact.title} description={pages.contact.description}>
    <h1>Contact me</h1>
    <p class="tagline">🚧 This page is a work in progress.</p>
    <nav>
        <ul>
            <li><a href={profiles.linkedin.href} target="_blank" rel="noopener">{profiles.linkedin.label}</a></li>
            <li><a href="/">Go home</a></li>
        </ul>
    </nav>
</BaseLayout>
