---
import BaseLayout from "../layouts/BaseLayout.astro";
import { person, profiles } from "../data/profile";

const links = [profiles.github, profiles.linkedin, profiles.credly];
---

<BaseLayout pageTitle="Home Page">
  <h1>{person.name}</h1>
  <p class="tagline">{person.title}</p>
  <nav>
    <ul>
      <li><a href="/contact/">Contact me</a></li>
      {links.map((link) => (
        <li><a href={link.href} target="_blank" rel="noopener">{link.label}</a></li>
      ))}
    </ul>
  </nav>
</BaseLayout>
