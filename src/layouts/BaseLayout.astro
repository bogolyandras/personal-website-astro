---
import "../styles/global.css";

interface Props {
    pageTitle: string;
    // Required so every page gets its own search-engine snippet
    description: string;
}

const { pageTitle, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{pageTitle} | András Bögöly's Personal Homepage</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <main>
            <slot />
        </main>
    </body>
</html>
